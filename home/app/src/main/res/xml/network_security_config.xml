<?xml version="1.0" encoding="utf-8"?>
<!-- Artwork and news headlines are fetched from whatever addresses their sources use, and a Home
     Assistant message can carry a picture from a Home Assistant on the same Wi-Fi - an address like
     http://homeassistant.local:8123 that no domain rule can name in advance.
     So plain HTTP is allowed throughout; everything else on this TV speaks https anyway. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
