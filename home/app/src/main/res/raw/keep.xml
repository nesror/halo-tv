<?xml version="1.0" encoding="utf-8"?>
<!-- app_banners and glass_logos name drawables at run time, which resource shrinking cannot see: keep every
     banner_* (banner artwork) and every logo_* (the white mark Glass Home draws on a tile). -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/banner_*,@drawable/logo_*" />
